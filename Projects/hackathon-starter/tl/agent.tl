acters|^(res.status 400).json#{error:"Message must be between 1 and $mm characters<sme message.trim|res.whe 200#{"Content-Type":"text/event-stream""Cache-Control":"no-cache"Connection:"keep-alive|try|guard gg|console.log"Creating customer service agent...|gg=await cai|console.log"Agent created successfully<console.log"Thread ID:"tb|stream await gg.stream#{messages:[(new core.AD sme)]}#{configurable:{kr:tb}rz:15 sc:["updates""custom|for await chunk stream|pair if((Array.ie chunk)and chunk.length==2)chunk ["updates"chunk|sc pair[0|data pair[1|ss res"raw"#{content:data sc:sc|if sc=="custom" and data?.message|ss res"status"#{message:data.message|continue<op eam data|op.fe msg=>ss res"chat"#{message:msg|je est data|if je|ss res"status"je<<ss res"done"#{|res.end()<catch err|console.error"AI Agent Error:"err|console.error"Error stack:"err.stack|nl err.message|if(err.message and(err.message.includes"recursion"))or err.name=="GraphRecursionError|nl="The AI agent hit the maximum thinking steps limit. Your request may be too complex. Please try breaking it into smaller questions, or try rephrasing your request.<ss res"error"#{error:nl|res.end()<<gost langchain.tool(async args config=>|ob args.ob|if config["writer|config.writer#{message:"Looking up order $ob...<if 0.2>(Math.random()|!new Error"API timeout - please retry<await(new Promise resolve=>setTimeout resolve 300+(Math.random())*200|ips 0.3>(Math.random()|oc["processing""shipped""delivered""cancelled|status oc[Math.floor(Math.random())*oc.length|JSON.stringify#{ob:ob status:status items:(if ips [{ic:"item1"name:"Wireless Headphones"status:"shipped"}{ic:"item2"name:"Phone Case"status:"processing"}{ic:"item3"name:"Screen Protector"status:"delivered"}] [{ic:"item1"name:"Wireless Headphones"status:status}])tn:(if status=="shipped"("TRK"+(((Math.random()).ts 36).slice 2 11).tv)null)ede:(if status=="shipped""2-3 business days"null<)#{name:"get_order_status"description:"Fetch status and details for an order by order ID"schema:(z