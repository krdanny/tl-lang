+npm.winston|+node.path|+config.config|transports[(new(Reflect.get winston.transports"Console"))]|if config.lb|console.log"Added log file at "+config.ll|transports.push(new(Reflect.get winston.transports"File")(obj{filename:(path.join config.lb"server.log") maxsize:100*1024 me:2 format:(winston.format.combine winston.format.timestamp winston.format.json)}))<console.log"Setting log level to "+config.ll|const logger winston.cre obj {level:(config.ll or"error") format:(winston.format.combine winston.format.timestamp winston.format.colorize(winston.format.printf info=>|splat info[Symbol.for"splat"]|if splat|sc(splat.map arg=>JSON.stringify arg).join"\n"|^"$info.timestamp - $info.level: $info.message $sc"<"$info.timestamp - $info.level: $info.message"<)) transports:transports}