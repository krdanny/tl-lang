+npm.winston|+node.path|+config.config|transports[(new(Reflect.get winston.transports"Console"))]|if config.ld|console.log"Added log file at "+config.ll|transports.push(new(Reflect.get winston.transports"File")(obj{filename:(path.join config.ld"server.log") maxsize:100*1024 mb:2 format:(winston.format.combine winston.format.timestamp winston.format.json)}))<console.log"Setting log level to "+config.ll|const logger winston.cl obj {level:(config.ll or"error") format:(winston.format.combine winston.format.timestamp winston.format.colorize(winston.format.printf info=>|splat info[Symbol.for"splat"]|if splat|sb(splat.map arg=>JSON.stringify arg).join"\n"|^"$info.timestamp - $info.level: $info.message $sb"<"$info.timestamp - $info.level: $info.message"<)) transports:transports}