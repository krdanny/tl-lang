aw /[a-zA-Z]:\\([^\\]+\\?)*/|ads /ssh:\/\/(.*):(\d*)\/(.*)/|ass /ssh:\/\/([^/]*)\/(.*)/|are /([^@]*)@([^:]*):([^.]*)(\.git)?$/|ag /([^:]*):([^.]*)(\.git)?$/|ab /https:\/\/([^/]*)\/([^.]*)(\.git)?$/|au /.*\/([^/]+)/|fn ep p|(encodeURIComponent p).replace /%2F/g"/"<fn pad remote|m aw.exec remote|if m|project m[1]|if project[project.length-1]=="\\"|project=project.slice 0 project.length-1<^obj{address:remote host:"localhost" project:project sp:project}<m=ads.exec remote|if m|^obj{address:remote host:m[1] port:m[2] project:m[3] sp:(m[3].split"/").pop}<m=ass.exec remote|if m|^obj{address:remote host:m[1] project:m[2] sp:(m[2].split"/").pop}<m=are.exec remote|if m|^obj{address:remote username:m[1] host:m[2] project:m[3] sp:(m[3].split"/").pop}<m=ag.exec remote|if m|^obj{address:remote host:m[1] project:m[2] sp:(m[2].split"/").pop}<m=ab.exec remote|if m|^obj{address:remote host:m[1] project:m[2] sp:(m[2].split"/").pop}<m=au.exec remote|if m|^obj{address:remote host:"localhost" project:m[1] sp:m[1]}<obj{address:remote}