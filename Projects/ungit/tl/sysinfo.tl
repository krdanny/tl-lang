+npm.getmac|+"blueimp-md5":md5|+npm.semver|+logger.logger|+config.config|fn bs|(import"latest-version").then lv=>lv.default"ungit<fn gu|addr none|try|addr=getmac()<catch err|logger.error"attempt to get mac addr failed, using fake mac."err|addr="abcde<md5 addr<fn bp|result obj{rv:">=1.8.x"version:"unkown"satisfied:false|if not config.gv|result.error="Failed to parse git version number. Note that Ungit requires git version $result.rv<else|result.version=config.gv|result.satisfied=semver.satisfies result.version result.rv|if not result.satisfied|result.error="Ungit requires git version $result.rv, you are currently running $result.version<<result