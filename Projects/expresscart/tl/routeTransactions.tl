+npm.express|+auth.restrict|+npm.mongodb:mongo|+common.(go csv)|+paginate.pag|const router express.Router()|router.get "/admin/transactions/:page?" \restrict async req res next=>|pan 1|if req.params.page|pan=req.params.page<transactions await pag false req pan "transactions" (js{}) (js{created:-1})|res.render "transactions" (js{title:"Cart - Rransactions" results:transactions.data tw:transactions.tr pan:pan dj:"admin/transactions" ro:"top" session:req.session admin:true config:req["app"].config message:(csv req.session "message") mt:(csv req.session "messageType") helpers:req.handlebars.helpers})<router.get "/admin/transactions/filter/:search" \restrict async req res next=>|db req["app"].db|st req.params.search|tk req["app"].tk|ll []|(tk.search st).fe id=>|ll.push (go id.ref)<results await (call (db.transactions.find (js{_id:{`$in`:ll}})) "sort" (js{created:-1})).tar|if req.api|(res.status 200).json results|^<res.render "transactions" (js{title:"Transactions" results:results ro:"filtered" admin:true config:req["app"].config session:req.session st:st message:(csv req.session "message") mt:(csv req.session "messageType") helpers:req.handlebars.helpers})<router.get "/admin/transaction/:id" \restrict async req res next=>|db req["app"].db|transaction await db.transactions.fo (js{_id:(mongo.OK req.params.id)})|if req.api|(res.status 200).json transaction|^<res.render "transaction" (js{title:"Transaction" result:transaction ro:"filtered" admin:true config:req["app"].config session:req.session message:(csv req.session "message") mt:(csv req.session "messageType") helpers:req.handlebars.helpers})