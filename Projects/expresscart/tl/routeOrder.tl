00).json (js{orders:orders})|^<res.render "orders" (js{title:"Order results" orders:orders admin:true config:req["app"].config session:req.session st:st message:(csv req.session "message") mt:(csv req.session "messageType") helpers:req.handlebars.helpers})<router.get "/admin/order/delete/:id" \restrict async req res=>|db req["app"].db|try|await db.orders.dc (js{_id:(ga req.params.id)})|(ind req["app"]).then ()=>|if req.api|(res.status 200).json (js{message:"Order successfully deleted"})|^<req.session.message="Order successfully deleted"|req.session.mt="success"|res.redirect "/admin/orders"<<catch ex|console.log "Cannot delete order" ex|if req.api|(res.status 200).json (js{message:"Error deleting order"})|^<req.session.message="Error deleting order"|req.session.mt="danger"|res.redirect "/admin/orders"<<router.post "/admin/order/updateorder" \restrict \ca async req res=>|db req["app"].db|try|updateobj js{os:req.body.status}|if req.body.tx|updateobj.tx=req.body.tx<await db.orders.ua (js{_id:(ga req.body.oi)}) (js{`$set`:updateobj}) (js{multi:false})|^(res.status 200).json (js{message:"Order successfully updated"})<catch ex|console.info "Error updating order" ex|^(res.status 400).json (js{message:"Failed to update the order"})