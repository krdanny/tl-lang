type Middleware;impl Middleware|init self robot|self.robot=robot|self.stack=[]<async execute self context|sc true|for await middleware self.stack|try|sc=await middleware context|if sc==false|break<<catch e|self.robot.emit"error"e context.response|break<<sc<register self middleware|if middleware.length!=1|!(new Error"Incorrect number of arguments for middleware callback (expected 1, got {middleware.length})")<self.stack.push middleware|none